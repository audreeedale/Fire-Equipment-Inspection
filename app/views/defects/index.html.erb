<% content_for :title, "Defects" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold">Defects</h1>
    <p class="text-muted">Track failed assets from identification through to rectification.</p>
  </div>
  <%= link_to "+ Log defect", new_defect_path, class: "bg-brand text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-brand-dark" %>
</div>

<div class="grid md:grid-cols-4 gap-4">
  <% %w[logged quoted scheduled resolved].each do |status| %>
    <% defects = @defects_by_status[status] || [] %>
    <div class="bg-panel-soft rounded-xl p-3">
      <div class="flex items-center justify-between px-1 pb-3 text-sm font-extrabold">
        <span><%= status.humanize %></span>
        <%= render "status_badge", status: status %>
      </div>

      <div class="space-y-2">
        <% defects.each do |defect| %>
          <div class="bg-panel border border-line rounded-xl p-3 shadow-sm">
            <h4 class="text-sm font-semibold mb-1"><%= truncate(defect.description, length: 70) %></h4>
            <p class="text-xs text-muted mb-3"><%= defect.address.display_name %> · <%= defect.asset.asset_no %></p>
            <div class="flex items-center justify-between">
              <%= render "priority_badge", priority: defect.priority %>
              <div class="flex items-center gap-2">
                <%= link_to "Edit", edit_defect_path(defect), class: "text-xs text-muted hover:underline" %>
                <% if defect.status != "resolved" %>
                  <%= button_to "Advance →", advance_defect_path(defect), method: :patch, class: "text-xs bg-nav text-white px-2 py-1 rounded-md cursor-pointer" %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
        <% if defects.empty? %>
          <p class="text-xs text-muted px-1">No defects here.</p>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
