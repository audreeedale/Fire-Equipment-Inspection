<%= turbo_frame_tag record do %>
  <div class="p-4">
    <div class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-muted mb-2">
      <span class="font-medium text-ink"><%= record.asset.asset_no %></span>
      <span>Building: <%= record.asset.building&.name || "—" %></span>
      <span>Level: <%= record.asset.level.presence || "—" %></span>
      <% if record.asset.area.present? %><span>Area: <%= record.asset.area %></span><% end %>
      <% if record.asset.size_and_type.present? %><span><%= record.asset.size_and_type %></span><% end %>
      <% if record.asset.type_code.present? %><span>Type: <%= record.asset.type_code %></span><% end %>
      <% if record.asset.brand.present? %><span><%= record.asset.brand %> <%= record.asset.length %></span><% end %>
    </div>

    <%= simple_form_for record, url: asset_inspection_record_path(record), method: :patch,
          html: { class: "grid grid-cols-1 md:grid-cols-4 md:divide-x md:divide-line items-start" } do |f| %>
      <%= f.input :defect_status, collection: AssetInspectionRecord.defect_statuses.keys, label: false,
            wrapper_html: { class: "md:pr-4" },
            input_html: { class: "border border-line rounded-lg px-2 py-1.5 text-sm w-full" } %>
      <%= f.input :defect_found, as: :text, label: false, placeholder: "Defect found",
            wrapper_html: { class: "md:px-4" },
            input_html: { rows: 1, class: "border border-line rounded-lg px-2 py-1.5 text-sm w-full" } %>
      <%= f.input :action_required, as: :text, label: false, placeholder: "Action required",
            wrapper_html: { class: "md:px-4" },
            input_html: { rows: 1, class: "border border-line rounded-lg px-2 py-1.5 text-sm w-full" } %>
      <div class="md:pl-4">
        <label class="inline-block cursor-pointer bg-panel-soft border border-line text-xs font-semibold px-3 py-1.5 rounded-lg hover:bg-line">
          Upload
          <%= f.file_field :photos, multiple: true, class: "hidden",
                data: { controller: "auto-submit", action: "change->auto-submit#submit" } %>
        </label>
      </div>
    <% end %>

    <% if record.photos.attached? %>
      <div class="flex gap-2 mt-3">
        <% record.photos.each do |photo| %>
          <%= image_tag photo, class: "h-16 w-16 object-cover rounded border" %>
        <% end %>
      </div>
    <% end %>

    <% unless record.defect_status_none? %>
      <%= link_to "Log defect →", new_defect_path(asset_inspection_record_id: record.id), class: "inline-block mt-3 text-xs text-brand font-semibold hover:underline" %>
    <% end %>
  </div>
<% end %>
