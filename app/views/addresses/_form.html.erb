<%= simple_form_for address, html: { class: "bg-panel border border-line rounded-xl p-6 max-w-2xl space-y-4" } do |f| %>
  <%= f.error_notification %>

  <div class="grid grid-cols-2 gap-4">
    <%= f.input :name, label: "Site name (optional)", wrapper_html: { class: "col-span-2" } %>
    <%= f.input :street_address, wrapper_html: { class: "col-span-2" } %>
    <%= f.input :suburb %>
    <%= f.input :state %>
    <%= f.input :postcode %>
    <%= f.input :contact_name %>
    <%= f.input :contact_phone %>
    <%= f.input :contact_email %>
    <%= f.input :notes, as: :text, wrapper_html: { class: "col-span-2" } %>
  </div>

  <%= f.button :submit, class: "bg-brand text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-brand-dark" %>
<% end %>
