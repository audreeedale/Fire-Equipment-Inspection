<% content_for :title, @address.display_name %>

<div class="bg-panel border border-line rounded-xl p-5 mb-4 flex items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= @address.display_name %></h1>
    <p class="text-muted"><%= @address.street_address %>, <%= @address.suburb %> <%= @address.state %> <%= @address.postcode %></p>
    <% if @address.contact_name.present? %>
      <p class="text-sm text-muted mt-1"><%= @address.contact_name %> · <%= @address.contact_phone %> · <%= @address.contact_email %></p>
    <% end %>
    <div class="mt-3"><%= render "schedules/status_badge", status: @address.overall_status %></div>
  </div>
  <div class="flex gap-2 shrink-0">
    <%= link_to "New Visit", new_address_inspection_visit_path(@address), class: "bg-brand text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-brand-dark" %>
    <%= link_to "Edit", edit_address_path(@address), class: "bg-panel border border-line text-sm font-semibold px-4 py-2 rounded-lg hover:bg-panel-soft" %>
  </div>
</div>

<div data-controller="tabs">
  <div class="inline-flex gap-1 bg-panel border border-line rounded-xl p-1 mb-4">
    <button data-tabs-target="tab" data-tab-name="overview" data-action="tabs#show" class="px-3 py-2 rounded-lg text-sm font-semibold bg-nav text-white">Overview</button>
    <button data-tabs-target="tab" data-tab-name="assets" data-action="tabs#show" class="px-3 py-2 rounded-lg text-sm font-semibold text-muted">Asset register</button>
    <button data-tabs-target="tab" data-tab-name="history" data-action="tabs#show" class="px-3 py-2 rounded-lg text-sm font-semibold text-muted">Inspection history</button>
  </div>

  <div data-tabs-target="panel" data-tab-name="overview">
    <div class="grid lg:grid-cols-3 gap-4">
      <div class="lg:col-span-2 space-y-4">
        <section class="bg-panel border border-line rounded-xl p-5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-semibold">Schedules</h2>
            <%= link_to "New Schedule", new_address_schedule_path(@address), class: "text-sm text-brand hover:underline" %>
          </div>
          <table class="min-w-full text-sm">
            <thead class="text-left text-muted">
              <tr>
                <th class="py-1 pr-4">Category</th>
                <th class="py-1 pr-4">Frequency</th>
                <th class="py-1 pr-4">Next due</th>
                <th class="py-1 pr-4">Status</th>
                <th class="py-1"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              <% @schedules.each do |schedule| %>
                <tr>
                  <td class="py-2 pr-4"><%= schedule.equipment_category&.humanize || "Whole site" %></td>
                  <td class="py-2 pr-4"><%= schedule.frequency.humanize %></td>
                  <td class="py-2 pr-4"><%= schedule.next_due_on.to_fs(:long) %></td>
                  <td class="py-2 pr-4"><%= render "schedules/status_badge", status: schedule.status %></td>
                  <td class="py-2 text-right"><%= link_to "Edit", edit_schedule_path(schedule), class: "text-xs text-muted hover:underline" %></td>
                </tr>
              <% end %>
              <% if @schedules.empty? %>
                <tr><td colspan="5" class="py-3 text-muted">No active schedules yet.</td></tr>
              <% end %>
            </tbody>
          </table>
        </section>

        <section class="bg-panel border border-line rounded-xl p-5">
          <h2 class="font-semibold mb-3">Recent activity</h2>
          <ul class="space-y-3">
            <% @recent_visits.first(3).each do |visit| %>
              <li class="flex gap-3">
                <span class="w-2 h-2 rounded-full bg-brand mt-1.5 shrink-0"></span>
                <div class="text-sm">
                  <strong class="block"><%= visit.status.humanize %> visit — <%= visit.visit_date.to_fs(:long) %></strong>
                  <span class="text-muted text-xs"><%= visit.inspector_name.presence || "Unassigned" %></span>
                </div>
              </li>
            <% end %>
            <% @recent_defects.each do |defect| %>
              <li class="flex gap-3">
                <span class="w-2 h-2 rounded-full bg-warning mt-1.5 shrink-0"></span>
                <div class="text-sm">
                  <strong class="block"><%= truncate(defect.description, length: 60) %></strong>
                  <span class="text-muted text-xs"><%= defect.asset.asset_no %> · <%= defect.status.humanize %></span>
                </div>
              </li>
            <% end %>
            <% if @recent_visits.empty? && @recent_defects.empty? %>
              <li class="text-sm text-muted">No recent activity yet.</li>
            <% end %>
          </ul>
        </section>
      </div>

      <div class="space-y-4">
        <section class="bg-panel border border-line rounded-xl p-5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-semibold">Buildings</h2>
            <%= link_to "New", new_address_building_path(@address), class: "text-sm text-brand hover:underline" %>
          </div>
          <ul class="text-sm divide-y divide-line">
            <% @buildings.each do |building| %>
              <li class="py-2 flex justify-between">
                <%= building.name %>
                <%= link_to "Edit", edit_building_path(building), class: "text-xs text-muted hover:underline" %>
              </li>
            <% end %>
            <% if @buildings.empty? %>
              <li class="py-3 text-muted">No buildings added.</li>
            <% end %>
          </ul>
        </section>

        <% if @address.notes.present? %>
          <section class="bg-panel border border-line rounded-xl p-5">
            <h2 class="font-semibold mb-2">Notes</h2>
            <p class="text-sm text-muted"><%= @address.notes %></p>
          </section>
        <% end %>
      </div>
    </div>
  </div>

  <div data-tabs-target="panel" data-tab-name="assets" class="hidden">
    <section class="bg-panel border border-line rounded-xl">
      <div class="flex items-center justify-between px-5 py-4 border-b border-line">
        <h2 class="font-semibold">Asset register</h2>
        <%= link_to "+ New Asset", new_address_asset_path(@address), class: "text-sm text-brand hover:underline" %>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="bg-panel-soft text-left text-muted">
            <tr>
              <th class="px-5 py-2">Asset no.</th>
              <th class="px-5 py-2">Category</th>
              <th class="px-5 py-2">Building</th>
              <th class="px-5 py-2">Level</th>
              <th class="px-5 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% @assets.each do |asset| %>
              <tr>
                <td class="px-5 py-2 font-medium"><%= asset.asset_no %></td>
                <td class="px-5 py-2"><%= asset.category.humanize %></td>
                <td class="px-5 py-2"><%= asset.building&.name %></td>
                <td class="px-5 py-2"><%= asset.level %></td>
                <td class="px-5 py-2 text-right"><%= link_to "Edit", edit_asset_path(asset), class: "text-xs text-muted hover:underline" %></td>
              </tr>
            <% end %>
            <% if @assets.empty? %>
              <tr><td colspan="5" class="px-5 py-6 text-center text-muted">No assets recorded yet.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <div data-tabs-target="panel" data-tab-name="history" class="hidden">
    <section class="bg-panel border border-line rounded-xl">
      <div class="flex items-center justify-between px-5 py-4 border-b border-line">
        <h2 class="font-semibold">Inspection history</h2>
        <%= link_to "View all", address_inspection_visits_path(@address), class: "text-sm text-brand hover:underline" %>
      </div>
      <ul class="divide-y divide-line">
        <% @recent_visits.each do |visit| %>
          <li class="px-5 py-3 flex justify-between text-sm">
            <%= link_to visit.visit_date.to_fs(:long), address_inspection_visit_path(@address, visit), class: "text-brand hover:underline" %>
            <span class="text-muted"><%= visit.inspector_name %> · <%= visit.status.humanize %></span>
          </li>
        <% end %>
        <% if @recent_visits.empty? %>
          <li class="px-5 py-3 text-muted text-sm">No visits recorded yet.</li>
        <% end %>
      </ul>
    </section>
  </div>
</div>
