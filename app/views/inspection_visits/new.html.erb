<% content_for :title, "New Inspection Visit" %>

<h1 class="text-2xl font-bold mb-6">New Inspection Visit — <%= @address.display_name %></h1>

<%= simple_form_for @visit, url: address_inspection_visits_path(@address), html: { class: "bg-panel border border-line rounded-xl p-6 max-w-xl space-y-4" } do |f| %>
  <%= f.error_notification %>

  <%= f.input :visit_date, as: :date %>
  <%= f.input :inspector_name %>
  <%= f.input :summary_notes, as: :text %>

  <%= f.button :submit, "Start Visit", class: "bg-brand text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-brand-dark" %>
<% end %>
