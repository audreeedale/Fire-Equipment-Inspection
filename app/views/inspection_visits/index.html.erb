<% content_for :title, "Inspection Visits" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Inspection Visits — <%= @address.display_name %></h1>
  <%= link_to "New Visit", new_address_inspection_visit_path(@address), class: "bg-brand text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-brand-dark" %>
</div>

<div class="bg-panel border border-line rounded-xl overflow-x-auto">
  <table class="min-w-full text-sm">
    <thead class="bg-panel-soft text-left text-muted">
      <tr>
        <th class="px-4 py-2">Date</th>
        <th class="px-4 py-2">Inspector</th>
        <th class="px-4 py-2">Status</th>
        <th class="px-4 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-line">
      <% @visits.each do |visit| %>
        <tr>
          <td class="px-4 py-2"><%= visit.visit_date.to_fs(:long) %></td>
          <td class="px-4 py-2"><%= visit.inspector_name %></td>
          <td class="px-4 py-2"><%= visit.status.humanize %></td>
          <td class="px-4 py-2 text-right"><%= link_to "View", address_inspection_visit_path(@address, visit), class: "text-sm text-brand hover:underline" %></td>
        </tr>
      <% end %>
      <% if @visits.empty? %>
        <tr><td colspan="4" class="px-4 py-6 text-center text-muted">No visits recorded yet.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
