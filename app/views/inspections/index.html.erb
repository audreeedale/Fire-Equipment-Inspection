<% content_for :title, "Inspections" %>

<div class="mb-6">
  <h1 class="text-2xl font-bold">Inspections</h1>
  <p class="text-muted">All inspection visits across every customer.</p>
</div>

<div class="flex gap-2 mb-4 text-sm">
  <%= link_to "All", inspections_path, class: "px-3 py-1 rounded-full #{params[:status].blank? ? 'bg-nav text-white' : 'bg-panel border border-line'}" %>
  <% InspectionVisit.statuses.each_key do |status| %>
    <%= link_to status.humanize, inspections_path(status: status), class: "px-3 py-1 rounded-full #{params[:status] == status ? 'bg-nav text-white' : 'bg-panel border border-line'}" %>
  <% end %>
</div>

<div class="bg-panel border border-line rounded-xl overflow-x-auto">
  <table class="min-w-full text-sm">
    <thead class="bg-panel-soft text-left text-muted">
      <tr>
        <th class="px-4 py-2">Date</th>
        <th class="px-4 py-2">Customer</th>
        <th class="px-4 py-2">Inspector</th>
        <th class="px-4 py-2">Status</th>
        <th class="px-4 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-line">
      <% @visits.each do |visit| %>
        <tr>
          <td class="px-4 py-2"><%= visit.visit_date.to_fs(:long) %></td>
          <td class="px-4 py-2"><%= link_to visit.address.display_name, address_path(visit.address), class: "text-brand hover:underline" %></td>
          <td class="px-4 py-2"><%= visit.inspector_name.presence || "—" %></td>
          <td class="px-4 py-2"><%= visit.status.humanize %></td>
          <td class="px-4 py-2 text-right"><%= link_to "View", address_inspection_visit_path(visit.address, visit), class: "text-sm text-brand hover:underline" %></td>
        </tr>
      <% end %>
      <% if @visits.empty? %>
        <tr><td colspan="5" class="px-4 py-6 text-center text-muted">No inspection visits yet.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
