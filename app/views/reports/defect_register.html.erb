<% content_for :title, "Defect Register" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold">Defect Register</h1>
    <p class="text-muted">Open, quoted, scheduled and resolved defects.</p>
  </div>
  <%= link_to "← Back to reports", reports_path, class: "text-sm text-muted hover:underline" %>
</div>

<div class="flex gap-2 mb-4 text-sm">
  <%= link_to "All statuses", reports_defect_register_path(priority: params[:priority]), class: "px-3 py-1 rounded-full #{params[:status].blank? ? 'bg-nav text-white' : 'bg-panel border border-line'}" %>
  <% Defect.statuses.each_key do |status| %>
    <%= link_to status.humanize, reports_defect_register_path(status: status, priority: params[:priority]), class: "px-3 py-1 rounded-full #{params[:status] == status ? 'bg-nav text-white' : 'bg-panel border border-line'}" %>
  <% end %>
</div>

<div class="bg-panel border border-line rounded-xl overflow-x-auto">
  <table class="min-w-full text-sm">
    <thead class="bg-panel-soft text-left text-muted">
      <tr>
        <th class="px-4 py-2">Defect</th>
        <th class="px-4 py-2">Customer</th>
        <th class="px-4 py-2">Asset</th>
        <th class="px-4 py-2">Priority</th>
        <th class="px-4 py-2">Status</th>
        <th class="px-4 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-line">
      <% @defects.each do |defect| %>
        <tr>
          <td class="px-4 py-2"><%= truncate(defect.description, length: 60) %></td>
          <td class="px-4 py-2"><%= defect.address.display_name %></td>
          <td class="px-4 py-2"><%= defect.asset.asset_no %></td>
          <td class="px-4 py-2"><%= render "defects/priority_badge", priority: defect.priority %></td>
          <td class="px-4 py-2"><%= render "defects/status_badge", status: defect.status %></td>
          <td class="px-4 py-2 text-right"><%= link_to "Edit", edit_defect_path(defect), class: "text-xs text-muted hover:underline" %></td>
        </tr>
      <% end %>
      <% if @defects.empty? %>
        <tr><td colspan="6" class="px-4 py-6 text-center text-muted">No defects match this filter.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
