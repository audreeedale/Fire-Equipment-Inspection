<% content_for :title, "Customer Compliance Summary" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold">Customer Compliance Summary</h1>
    <p class="text-muted">Schedule status across every customer, computed from active schedules.</p>
  </div>
  <%= link_to "← Back to reports", reports_path, class: "text-sm text-muted hover:underline" %>
</div>

<div class="bg-panel border border-line rounded-xl overflow-x-auto">
  <table class="min-w-full text-sm">
    <thead class="bg-panel-soft text-left text-muted">
      <tr>
        <th class="px-4 py-2">Customer</th>
        <th class="px-4 py-2">Suburb</th>
        <th class="px-4 py-2">Active schedules</th>
        <th class="px-4 py-2">Status</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-line">
      <% @addresses.each do |address| %>
        <tr>
          <td class="px-4 py-2"><%= link_to address.display_name, address_path(address), class: "text-brand hover:underline" %></td>
          <td class="px-4 py-2"><%= address.suburb %></td>
          <td class="px-4 py-2"><%= address.schedules.active.count %></td>
          <td class="px-4 py-2"><%= render "schedules/status_badge", status: address.overall_status %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
